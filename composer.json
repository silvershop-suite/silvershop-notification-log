{
    "name": "silvershop-suite/notification-log",
    "description": "An opt-in, immutable audit log of every email SilverShop sends: who was mailed, which notification, when, and whether it went — captured zero-touch at the framework mailer, with a read-only Notifications tab on Order and Member and configurable, GDPR-minded retention and erasure.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "silvershop",
        "ecommerce",
        "audit",
        "email",
        "notifications",
        "gdpr"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl",
            "role": "Lead developer"
        },
        {
            "name": "SilverShop-Suite Contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silvershop/core": "^6"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "suggest": {
        "silvershop-suite/order-admin": "Groups the Notifications tab in with the order-admin tab layout and can source it into the order activity timeline.",
        "silvershop-suite/cookieconsent": "A central 'forget / export this customer' flow can call the module's erase()/export() hooks so the log is swept too."
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\NotificationLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\NotificationLog\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
